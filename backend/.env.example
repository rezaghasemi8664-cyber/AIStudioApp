NODE_ENV=development
PORT=5000
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
REDIS_URL="redis://localhost:6379"
BRS_API_KEY=""
GAPGPT_API_KEY=""

# SMTP email service
SMTP_HOST="smtp.example.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="noreply@example.com"
SMTP_PASS=""
SMTP_FROM_EMAIL="noreply@example.com"
SMTP_FROM_NAME="تحلیلگر هوشمند بورس رونیا"
SMTP_CONNECTION_TIMEOUT="10000"
SMTP_GREETING_TIMEOUT="10000"
SMTP_SOCKET_TIMEOUT="15000"
PASSWORD_VAULT_KEY="change-this-to-a-long-random-secret"

# Admin database backup
# SQL Server service account must have write permission on this directory.
ADMIN_BACKUP_DIR="C:\\RoniyaBackups"
# Restore is intentionally disabled by default.
ADMIN_RESTORE_ENABLED="false"
# Keep false to block restoring directly onto the production database.
ADMIN_ALLOW_PRODUCTION_RESTORE="false"
# Optional explicit non-production restore target, e.g. Roniya_Staging
ADMIN_RESTORE_TARGET=""

# CI/CD deployment gate
# Must be a long random secret and must NEVER be exposed to the frontend.
DEPLOYMENT_WEBHOOK_SECRET="change-this-to-a-long-random-secret"
# Production/stable deployments require a fresh, validated database backup by default.
ADMIN_REQUIRE_BACKUP_FOR_PRODUCTION_DEPLOY="true"
